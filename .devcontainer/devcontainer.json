{
  "name": "ZTX Development",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "runServices": ["postgres", "app"],
  "workspaceFolder": "/workspaces/ztx",
  "forwardPorts": [5432, 8080, 5173],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "26.13.1" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["fwcd.kotlin", "vscjava.vscode-gradle", "ms-azuretools.vscode-docker", "Vue.volar"]
    }
  }
}
