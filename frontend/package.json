{
  "name": "ztx-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=26.13.1" },
  "scripts": {
    "dev": "pnpm --filter @ztx/erp-web dev",
    "build": "pnpm --filter @ztx/erp-web build",
    "typecheck": "pnpm --filter @ztx/erp-web typecheck",
    "test": "pnpm --filter @ztx/erp-web test",
    "test:e2e": "pnpm --filter @ztx/erp-web test:e2e",
    "lint": "eslint . --ext .js,.ts,.vue",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "^16.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
